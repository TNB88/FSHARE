<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TorBox Việt — Kích hoạt"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Nhập mã cá nhân để cấu hình TorBox nhanh. Cấu hình dùng chung với TorraStream; API key chỉ lưu trên thiết bị và luôn được ẩn."
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Cần cấp mã hoặc hỗ trợ? Bình Pro — SĐT &amp; Zalo: 0907 657 980"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/quick_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:hint="Mã kích hoạt nhanh"
            android:inputType="textPassword"
            android:maxLines="1" />

        <Button
            android:id="@+id/apply_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Kích hoạt bằng mã" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Hoặc nhập API key TorBox trực tiếp"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="API key TorBox"
            android:inputType="textPassword"
            android:maxLines="1" />

        <Button
            android:id="@+id/save_api"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Lưu API TorBox" />

        <Button
            android:id="@+id/clear_torbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Xóa cấu hình TorBox trên máy" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="24dp"
            android:text="Chưa kích hoạt TorBox."
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
