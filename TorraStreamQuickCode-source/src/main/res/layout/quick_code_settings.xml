<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TorraStream — Nhập mã nhanh"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Nhập mã cá nhân để tự động cấu hình TorBox hoặc Real-Debrid cho TorraStream và TorraStream-Anime. API key sẽ được ẩn khỏi phần cài đặt TorraStream."
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Cần cấp mã hoặc hỗ trợ? Liên hệ Bình Pro qua Zalo 0907 657 980."
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/quick_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:hint="Mã cá nhân"
            android:inputType="textPassword"
            android:maxLines="1" />

        <Spinner
            android:id="@+id/provider_spinner"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/apply_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Áp dụng mã" />

        <Button
            android:id="@+id/clear_debrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Xóa cấu hình Debrid trên máy" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="24dp"
            android:text="Chưa cấu hình."
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
